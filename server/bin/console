#!/usr/bin/env php
<?php
/**
 * Proland Production Planning — command line.
 *   php bin/console migrate            create / update tables and master data
 *   php bin/console import [file]      import the Excel workbook (default: data/Prodction_Data.xlsx)
 *   php bin/console seed-users         create the demo / test accounts
 *   php bin/console seed-demo          run the five demonstration scenarios
 *   php bin/console backup             write a JSON + SQL dump to server/data/backups
 *   php bin/console create-user <username> <password> <role> [display name]
 *   php bin/console reset-password <username> <password>
 */
require __DIR__ . '/../src/App.php';
$app = new App();
$cmd = $argv[1] ?? 'help';
$out = fn($m) => fwrite(STDOUT, $m . PHP_EOL);
try {
    switch ($cmd) {
        case 'migrate': $app->migrate(); $out('Schema ready (' . $app->db->driver . ').'); break;
        case 'import':
            $app->migrate();
            $t = microtime(true);
            $s = $app->importer->import($argv[2] ?? null, fn($m) => $out('  … ' . $m));
            $out(json_encode($s, JSON_PRETTY_PRINT));
            $out('Imported in ' . round(microtime(true) - $t, 1) . 's');
            break;
        case 'seed-users': $app->migrate(); $out('Created: ' . implode(', ', $app->seeder->seedUsers()) ?: 'nothing (already exist)'); break;
        case 'seed-demo': $app->migrate(); $r = (new DemoSeeder($app))->run(fn($m) => $out('  … ' . $m)); $out(json_encode($r, JSON_PRETTY_PRINT)); break;
        case 'backup': $f = (new Backup($app))->run(); $out("Backup written: $f"); break;
        case 'create-user': $app->migrate(); $id = $app->auth->createUser($argv[2], $argv[3], $argv[5] ?? $argv[2], strtoupper($argv[4])); $out("User #$id created"); break;
        case 'reset-password': $app->db->run('UPDATE {p}users SET password_hash=? WHERE username=?', [$app->auth->hashPassword($argv[3]), strtolower($argv[2])]); $out('Password updated'); break;
        default: $out(file_get_contents(__FILE__, false, null, 0, 700));
    }
} catch (Throwable $e) { fwrite(STDERR, get_class($e) . ': ' . $e->getMessage() . PHP_EOL . $e->getTraceAsString() . PHP_EOL); exit(1); }
