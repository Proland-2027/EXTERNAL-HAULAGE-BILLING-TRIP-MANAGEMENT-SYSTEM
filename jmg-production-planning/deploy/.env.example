# Public host name pointing at this server (Caddy obtains a Let's Encrypt certificate for it)
DOMAIN=planning.example.com
# Database passwords (choose strong values)
DB_PASSWORD=change-me-wordpress
DB_ROOT_PASSWORD=change-me-root
# WordPress administrator created by setup.sh
WP_ADMIN_USER=admin
WP_ADMIN_EMAIL=admin@example.com
WP_TITLE=JMG Production Planning
